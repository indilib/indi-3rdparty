# 1. Pre-renumeration IDs
# Meade DSI
SUBSYSTEM=="usb", ACTION=="add", ATTRS{idVendor}=="156c", ATTRS{idProduct}=="0100", RUN+="/sbin/fxload -t fx2 -I /usr/lib/firmware/meade-deepskyimager.hex -p $env{BUSNUM},$env{DEVNUM}"
SUBSYSTEM=="usb", ACTION=="add", ATTRS{idVendor}=="156c", ATTRS{idProduct}=="01ed", RUN+="/sbin/fxload -t fx2 -I /usr/lib/firmware/meade-deepskyimager.hex -p $env{BUSNUM},$env{DEVNUM}"

# 2. Post-renumeration IDs
# Meade DSI
SUBSYSTEM=="usb", ACTION=="add", ATTRS{idVendor}=="156c", ATTRS{idProduct}=="0101", MODE="0666", SYMLINK+="deepskyimager.%n"
