# What the frames in gen3-com20-session.wire decode to.
#
# Every value here was read out of the frame by hand against the documented layout, not copied from what
# the driver printed - a vector whose expectations come from the code under test only proves that the
# code has not changed.
#
# The status values are those of the FIRST status frame, the one the open takes. The second belongs to the
# fault read, which refreshes the status itself to get a fault count that cannot already be stale.

identification.hardwareMajor       = 3
identification.hardwareMinor       = 0
identification.interfaceMajor      = 1
identification.interfaceMinor      = 0
identification.hardwareIdentifier  = 2B002E000D4330364E353020
identification.softwareIdentifier  = 0DB6680E44C2851919E2FFEBFFAA93F257C3321C

capabilities.statusFrameLength     = 60
capabilities.dtcSnapshotLength     = 48
capabilities.hasUsbHub             = 1
capabilities.hasSmartSwitches      = 1
capabilities.hasTemperatureSensor  = 1

# 34 EF = 13551 mV
status.supplyVoltage               = 13551
# 0C AA = 3242 mV
status.sensorSupplyVoltage         = 3242
# 35 08 = 13576 mV
status.fanAVoltage                 = 13576
# 34 95 = 13461 mV
status.fanBVoltage                 = 13461
# 00 2F = 47 C
status.controllerTemperature       = 47
# 0C CA = 3274 mV
status.controllerSupplyVoltage     = 3274
# 00 19 = 25, which is 0.5 K in fiftieths
status.fanATargetDT                = 25
status.fanBTargetDT                = 25
# 3B 15 = 15125, which is 29.5 C
status.ambientTemperatureRaw       = 15125
status.ambientTemperatureValid     = 1
# 3A DD = 15069, which is 28.38 C
status.mirrorTemperatureRaw        = 15069
status.mirrorTemperatureValid      = 1
# 00 0F 42 40 = 1000000 steps, halted
status.motor1Position              = 1000000
status.motor1Moving                = 0
status.motor1Load                  = 0
status.motor2Position              = 0
status.motor2Moving                = 0
status.flatboxDuty                 = 0
status.powerSwitch1State           = 0
status.powerSwitch2State           = 0
status.fanAManualOverrideEnabled   = 0
status.fanBManualOverrideEnabled   = 0
status.storedFaultCount            = 1
status.activeFaultCount            = 0
status.cpuLoad                     = 3
status.peakCpuLoad                 = 3
# 3F = 63 percent
status.stackUsage                  = 63
status.i2cErrorCounter             = 0
status.usb1PowerActive             = 1
status.usb2PowerActive             = 1
status.usb1PowerFailure            = 0
status.usb2PowerFailure            = 0

# One record: code 0x0001, seen once, no longer present. Its freeze frame is 48 bytes and holds 36
# fields on this generation, the last of which are the USB hub ones that generation 2 does not have.
faults.count                       = 1
faults.0.code                      = 1
faults.0.name                      = EEPROM dataset corrupted (0x0001)
faults.0.occurrenceCount           = 1
faults.0.isActive                  = 0
faults.0.snapshotFieldCount        = 36
# 07 E9 01 01 in the freeze frame, and no time of day
faults.0.timestamp                 = 2025-01-01 00:00:00
# The rails all read 0x7FFF, the sensor value for "nothing measured"
faults.0.field.Supply voltage      = 32767
faults.0.field.RTC year            = 2025
faults.0.field.USB DS1 power active = 1
